# Noms des variables, sans valeurs. Les valeurs vivent dans Vercel (Settings > Environment Variables).
# En local, .env.local avec l'adresse d'une branche Neon à vous (voir docs/passation.md), jamais la production.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AUTH_SECRET=
ADMIN_EMAIL=
EQUIPE_VOIT_TOUT=
RESEND_GROMAA=
COURRIEL_EXPEDITEUR=
OPENWEATHER_GROMAA=
BLOB_READ_WRITE_TOKEN=
SENTRY_API_KEY=
CRON_SECRET=
FLUX_DE_NUIT_API_KEY=
FLUX_DEPUIS=
SITE_URL=
MY_claude=
VOYAGE_AI=
VOYAGE_MODELE=
IA_BUDGET_MENSUEL_EUR=
# Transition seulement : le nom et le dépôt se règlent dans groma (Réglages). Ces deux
# variables ne servent que tant que rien n'y a été saisi.
ENTREPRISE_NOM=
DEPOT_ADRESSE=
